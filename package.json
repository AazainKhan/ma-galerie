{
  "name": "eva-astro-starter",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "printf '_worker.js\n.DS_Store\n**/.DS_Store\n' > dist/.assetsignore",
    "build:cloudflare": "NODE_ENV=production astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && biome check",
    "check:fix": "astro check && biome check --write",
    "stylelint": "stylelint '**/*.{astro,css}'",
    "stylelint:fix": "stylelint '**/*.{astro,css}' --fix",
    "deploy": "wrangler deploy",
    "deploy:staging": "NODE_ENV=staging wrangler deploy --env staging",
    "deploy:production": "NODE_ENV=production wrangler deploy",
    "deploy:version": "wrangler versions upload",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.js",
    "seed:local": "node scripts/seed-database.js",
    "seed:remote": "node scripts/seed-database.js --remote",
    "monitor": "wrangler tail --format pretty",
    "analyze": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fancyapps/ui": "^6.1.14",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-spring/shared": "^10.1.2",
    "@react-spring/web": "^10.1.2",
    "@supabase/supabase-js": "^2.112.3",
    "@types/react": "^18.2.0",
    "@use-gesture/react": "^10.3.1",
    "astro": "^5.16.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "html-to-image": "^1.11.13",
    "lenis": "^1.3.26",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "smartypants": "^0.2.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "image-size": "^2.0.2",
    "postcss": "^8.5.26",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "stylelint": "^16.23.1",
    "stylelint-config-astro": "^1.0.4",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.123.0"
  }
}
