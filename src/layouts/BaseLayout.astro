---
import "~/styles/global.css";

import smartypants from "smartypants";
import GridGlow from "~/components/GridGlow";

const siteName = "Ma Galerie - Aazain";

export interface Props {
  title: string;
  description: string;
  image?: {
    src: string;
    alt: string;
  };
}

const { title, description, image } = Astro.props;

// Read persisted theme from cookie so SSR can render correct theme without flash/reset
const themeCookie = Astro.cookies.get("theme")?.value;
const initialTheme =
  themeCookie === "dark" || themeCookie === "light" ? themeCookie : undefined;

const paletteCookie = Astro.cookies.get("palette")?.value;
const VALID_PALETTES = [
  "regal-navy",
  "indigo",
  "charcoal-blue",
  "honeydew",
  "powder-blue",
  "bright-amber",
];
const initialPalette = VALID_PALETTES.includes(paletteCookie ?? "")
  ? paletteCookie
  : undefined;

// --bg-app per palette in light/dark, used for the iOS Safari status-bar colour
// (<meta theme-color>). Rendered server-side with prefers-color-scheme media
// queries so Safari — which only honours theme-color present in the source HTML,
// not JS-set ones — gets the right colour for the device appearance.
const PALETTE_BG: Record<string, { light: string; dark: string }> = {
  default: { light: "#ffffff", dark: "#151515" },
  "regal-navy": { light: "#faf0ca", dark: "#0d3b66" },
  indigo: { light: "#f5eeff", dark: "#42047e" },
  "charcoal-blue": { light: "#e8f4f3", dark: "#264653" },
  honeydew: { light: "#ebf5df", dark: "#1a2e16" },
  "powder-blue": { light: "#dce8f8", dark: "#103783" },
  "bright-amber": { light: "#f8c828", dark: "#003d30" },
};
const tcEntry = PALETTE_BG[initialPalette ?? "default"] ?? PALETTE_BG.default;
// When an explicit theme cookie exists, also emit a non-media override so a
// manual toggle that differs from the device appearance still matches.
const tcExplicit = initialTheme ? tcEntry[initialTheme] : null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = Astro.url.pathname === "/" ? title : `${title} · ${siteName}`;

// Cursor grid-glow everywhere except the albums "desktop" page (it has its own
// interactive canvas). Individual album pages keep it.
const albumsDesktopPath =
  Astro.url.pathname === "/albums" || Astro.url.pathname === "/albums/";
const showGridGlow = !albumsDesktopPath;
---

<html lang="en" data-theme={initialTheme} data-palette={initialPalette} class={initialTheme === "dark" ? "dark" : undefined} style={initialTheme ? `color-scheme: ${initialTheme}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <!-- MUST be first: apply theme+palette before any CSS renders to eliminate flash -->
    <script is:inline>
      (function () {
        try {
          var r = document.documentElement;
          // ── Theme ──────────────────────────────────────────────────────
          var theme = localStorage.getItem('theme');
          if (!theme) theme = (document.cookie.match(/(?:^|;\s*)theme=([^;]+)/) || [])[1] || null;
          if (!theme) theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          r.dataset.theme = theme;
          r.style.colorScheme = theme;
          r.classList.toggle('dark', theme === 'dark');
          document.cookie = 'theme=' + theme + '; path=/; max-age=31536000; samesite=lax';

          // ── Palette ────────────────────────────────────────────────────
          var palette = localStorage.getItem('palette');
          if (!palette) palette = (document.cookie.match(/(?:^|;\s*)palette=([^;]+)/) || [])[1] || null;
          if (palette && palette !== 'default') {
            r.dataset.palette = palette;
            document.cookie = 'palette=' + palette + '; path=/; max-age=31536000; samesite=lax';
          } else if (!palette) {
            // No stored preference — keep whatever SSR rendered
          } else {
            delete r.dataset.palette;
          }
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* iOS Safari status-bar colour. Server-rendered (Safari ignores JS-set
        theme-color). The media-query pair follows the device appearance; the
        explicit one (if a theme cookie exists) overrides for a manual toggle. */}
    <meta name="theme-color" content={tcEntry.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={tcEntry.dark} media="(prefers-color-scheme: dark)" />
    {tcExplicit && <meta name="theme-color" content={tcExplicit} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🖼️</text></svg>" />
    
    <!-- Preload critical fonts to prevent FOUT -->
    <link rel="preload" href="/fonts/PPEditorialNew-Ultralight.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Michroma-Regular.woff2" as="font" type="font/woff2" crossorigin />
    
    <title set:html={smartypants(pageTitle, 1)} />
    <meta name="description" content={smartypants(description, 1)} />
    <meta property="og:title" content={smartypants(title, 1)} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={smartypants(description, 1)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteName} />
    {
      image && (
        <>
          <meta property="og:image" content={image.src} />
          <meta property="og:image:alt" content={image.alt} />
        </>
      )
    }
    </head>
  <body>
    {showGridGlow && <GridGlow client:load />}
    <header class="site-header">
      <nav class="nav">
        <div class="brand"><a href="/">Ma Galerie</a></div>
        <div class="spacer" />
        <ul class="links" role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/albums">Albums</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
        <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" title="Open menu">
          <span class="sr-only">Open menu</span>
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16" />
            <path d="M4 12h16" />
            <path d="M4 18h16" />
          </svg>
        </button>
        <!-- Palette picker -->
        <div class="palette-wrapper">
          <button class="palette-btn" type="button" aria-label="Choose color palette" title="Choose color palette">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <rect x="1"   y="1"   width="6" height="6" rx="1.5" opacity="1"/>
              <rect x="9"   y="1"   width="6" height="6" rx="1.5" opacity="0.65"/>
              <rect x="1"   y="9"   width="6" height="6" rx="1.5" opacity="0.45"/>
              <rect x="9"   y="9"   width="6" height="6" rx="1.5" opacity="0.82"/>
            </svg>
          </button>
          <div class="palette-panel" role="listbox" aria-label="Color themes">
            <button class="palette-swatch" data-p="default" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#151515"></span><span class="swatch-bot" style="background:#ffffff"></span></span>
              <span class="swatch-label">Default</span>
            </button>
            <button class="palette-swatch" data-p="regal-navy" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#0d3b66"></span><span class="swatch-bot" style="background:#faf0ca"></span></span>
              <span class="swatch-label">Regal Navy</span>
            </button>
            <button class="palette-swatch" data-p="indigo" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#42047e"></span><span class="swatch-bot" style="background:#07f49e"></span></span>
              <span class="swatch-label">Indigo Mint</span>
            </button>
            <button class="palette-swatch" data-p="charcoal-blue" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#264653"></span><span class="swatch-bot" style="background:#2a9d8f"></span></span>
              <span class="swatch-label">Charcoal Teal</span>
            </button>
            <button class="palette-swatch" data-p="honeydew" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#ebf5df"></span><span class="swatch-bot" style="background:#bad4aa"></span></span>
              <span class="swatch-label">Honeydew</span>
            </button>
            <button class="palette-swatch" data-p="powder-blue" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#103783"></span><span class="swatch-bot" style="background:#9bafd9"></span></span>
              <span class="swatch-label">Powder Blue</span>
            </button>
            <button class="palette-swatch" data-p="bright-amber" role="option">
              <span class="swatch-circle"><span class="swatch-top" style="background:#f8c828"></span><span class="swatch-bot" style="background:#007e5d"></span></span>
              <span class="swatch-label">Amber Teal</span>
            </button>
          </div>
        </div>

        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <span class="sr-only">Toggle theme</span>
          <svg
            class="icon-sun"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.93 4.93 1.41 1.41" />
            <path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.34 17.66-1.41 1.41" />
            <path d="m19.07 4.93-1.41 1.41" />
          </svg>
          <svg
            class="icon-moon"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
        </button>
      </nav>

      <!-- Mobile menu panel -->
      <div id="mobile-menu" class="mobile-menu">
        <ul class="links" role="list">
          <li><a href="/">Home</a></li>
          <li><a href="/albums">Albums</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
        <div class="mobile-actions">
          <!-- Mobile palette picker -->
          <div class="palette-wrapper palette-wrapper-mobile">
            <button class="palette-btn" type="button" aria-label="Choose color palette" title="Choose color palette">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <rect x="1"   y="1"   width="6" height="6" rx="1.5" opacity="1"/>
                <rect x="9"   y="1"   width="6" height="6" rx="1.5" opacity="0.65"/>
                <rect x="1"   y="9"   width="6" height="6" rx="1.5" opacity="0.45"/>
                <rect x="9"   y="9"   width="6" height="6" rx="1.5" opacity="0.82"/>
              </svg>
            </button>
            <div class="palette-panel" role="listbox" aria-label="Color themes">
              <button class="palette-swatch" data-p="default" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#151515"></span><span class="swatch-bot" style="background:#ffffff"></span></span>
                <span class="swatch-label">Default</span>
              </button>
              <button class="palette-swatch" data-p="regal-navy" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#0d3b66"></span><span class="swatch-bot" style="background:#faf0ca"></span></span>
                <span class="swatch-label">Regal Navy</span>
              </button>
              <button class="palette-swatch" data-p="indigo" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#42047e"></span><span class="swatch-bot" style="background:#07f49e"></span></span>
                <span class="swatch-label">Indigo Mint</span>
              </button>
              <button class="palette-swatch" data-p="charcoal-blue" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#264653"></span><span class="swatch-bot" style="background:#2a9d8f"></span></span>
                <span class="swatch-label">Charcoal Teal</span>
              </button>
              <button class="palette-swatch" data-p="honeydew" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#ebf5df"></span><span class="swatch-bot" style="background:#bad4aa"></span></span>
                <span class="swatch-label">Honeydew</span>
              </button>
              <button class="palette-swatch" data-p="powder-blue" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#103783"></span><span class="swatch-bot" style="background:#9bafd9"></span></span>
                <span class="swatch-label">Powder Blue</span>
              </button>
              <button class="palette-swatch" data-p="bright-amber" role="option">
                <span class="swatch-circle"><span class="swatch-top" style="background:#f8c828"></span><span class="swatch-bot" style="background:#007e5d"></span></span>
                <span class="swatch-label">Amber Teal</span>
              </button>
            </div>
          </div>
          <!-- Mobile theme toggle -->
          <button id="theme-toggle-mobile" class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
            <span class="sr-only">Toggle theme</span>
            <svg class="icon-sun" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
            </svg>
            <svg class="icon-moon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Frosted scrim behind the open mobile nav menu -->
    <div id="menu-backdrop" class="menu-backdrop" aria-hidden="true"></div>

    <slot />

    <script>
      // ── Theme ────────────────────────────────────────────────────────
      const desktopThemeBtn = document.getElementById("theme-toggle");
      const mobileThemeBtn = document.getElementById("theme-toggle-mobile");
      const themeButtons = [desktopThemeBtn, mobileThemeBtn].filter(Boolean);

      // Browsers that DO honour JS theme-color (Chrome, etc.): keep a single
      // non-media override meta in sync with the actual rendered background, so
      // a manual theme/palette toggle updates the bar immediately. iOS Safari
      // ignores this and uses the server-rendered media-query metas instead.
      function syncThemeColor() {
        try {
          const c = getComputedStyle(document.documentElement).backgroundColor;
          if (!c || c === "rgba(0, 0, 0, 0)" || c === "transparent") return;
          let meta = document.querySelector(
            'meta[name="theme-color"]:not([media])',
          );
          if (!meta) {
            meta = document.createElement("meta");
            meta.setAttribute("name", "theme-color");
            document.head.appendChild(meta);
          }
          meta.setAttribute("content", c);
        } catch (_) {}
      }

      function setTheme(theme: "light" | "dark") {
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.documentElement.classList.toggle("dark", theme === "dark");
        try { localStorage.setItem("theme", theme); } catch (_) {}
        try { document.cookie = `theme=${theme}; path=/; max-age=31536000; samesite=lax`; } catch (_) {}
        syncThemeColor();
      }

      function toggleTheme() {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        setTheme(next);
      }

      themeButtons.forEach((b: Element | null) => b?.addEventListener("click", toggleTheme));

      // ── Palette ──────────────────────────────────────────────────────
      function markActiveSwatch(name: string) {
        document.querySelectorAll(".palette-swatch[data-p]").forEach((btn) => {
          (btn as HTMLElement).classList.toggle("active", btn.getAttribute("data-p") === name);
        });
      }

      function applyPalette(name: string) {
        if (!name || name === "default") {
          delete document.documentElement.dataset.palette;
        } else {
          document.documentElement.dataset.palette = name;
        }
        try { localStorage.setItem("palette", name); } catch (_) {}
        try { document.cookie = `palette=${name}; path=/; max-age=31536000; samesite=lax`; } catch (_) {}
        markActiveSwatch(name);
        closePalettePanel();
        syncThemeColor();
      }

      // Sync active swatch on every load / bfcache restore
      function syncSwatchState() {
        // Re-read from localStorage so state is correct even after bfcache navigation
        const stored = (() => { try { return localStorage.getItem("palette"); } catch (_) { return null; } })();
        const current = stored || document.documentElement.dataset.palette || "default";
        if (current && current !== "default") document.documentElement.dataset.palette = current;
        else if (current === "default") delete document.documentElement.dataset.palette;
        markActiveSwatch(current || "default");
      }
      syncSwatchState();
      syncThemeColor();

      // bfcache: re-sync when navigating back/forward
      window.addEventListener("pageshow", (e) => {
        if (e.persisted) {
          syncSwatchState();
          syncThemeColor();
        }
      });

      document.querySelectorAll(".palette-swatch[data-p]").forEach((btn) => {
        btn.addEventListener("click", () => applyPalette(btn.getAttribute("data-p") ?? "default"));
      });

      // ── Palette panel: click-to-open (handles desktop + mobile copies) ──
      const paletteWrappers = document.querySelectorAll(".palette-wrapper") as NodeListOf<HTMLElement>;

      function closePalettePanel() {
        paletteWrappers.forEach(w => w.classList.remove("open"));
      }

      paletteWrappers.forEach(wrapper => {
        const btn = wrapper.querySelector(".palette-btn") as HTMLElement | null;
        btn?.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = wrapper.classList.contains("open");
          closePalettePanel();
          if (!isOpen) wrapper.classList.add("open");
        });
      });

      document.addEventListener("click", (e) => {
        let inside = false;
        paletteWrappers.forEach(w => { if (w.contains(e.target as Node)) inside = true; });
        if (!inside) closePalettePanel();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePalettePanel();
      });

      // ── Mobile menu ──────────────────────────────────────────────────
      const menuBtn = document.getElementById("menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      const menuBackdrop = document.getElementById("menu-backdrop");

      function openMenu(open: boolean) {
        if (!menuBtn || !mobileMenu) return;
        menuBtn.setAttribute("aria-expanded", String(open));
        mobileMenu.classList.toggle("open", open);
        menuBackdrop?.classList.toggle("open", open);
        document.documentElement.classList.toggle("no-scroll", open);
        document.querySelector(".site-header")?.classList.toggle("menu-open", open);
      }

      menuBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        openMenu(menuBtn.getAttribute("aria-expanded") !== "true");
      });

      menuBackdrop?.addEventListener("click", () => openMenu(false));

      document.addEventListener("click", (e) => {
        if (!mobileMenu?.classList.contains("open")) return;
        const target = e.target as HTMLElement;
        if (!mobileMenu.contains(target) && target !== menuBtn) openMenu(false);
      });

      mobileMenu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => openMenu(false)));

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") { openMenu(false); closePalettePanel(); }
      });
    </script>

  </body>
</html>
