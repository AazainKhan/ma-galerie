---
import LoginForm from "~/components/admin/LoginForm";
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Admin Login" description="Login to manage your gallery">
  <div class="login-page">
    <LoginForm client:load />
  </div>
</BaseLayout>

<style>
  .login-page {
    min-height: 80dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
</style>
