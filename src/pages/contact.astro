---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Get in touch with me on social media.">
	<main class="contact-container">
		<div class="contact-content">
			<h1 class="contact-title">Get in Touch</h1>
			<p class="contact-description">
				Connect with me on social media to see more of my work and stay updated with my latest photography.
			</p>
			
			<div class="social-links">
				<a href="https://instagram.com/refractiveaazain" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Follow me on Instagram">
					<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
						<path d="m16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
						<line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
					</svg>
					<span>Instagram</span>
				</a>
				
				<a href="https://linkedin.com/in/aazainkhan" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Connect with me on LinkedIn">
					<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
						<rect width="4" height="12" x="2" y="9"/>
						<circle cx="4" cy="4" r="2"/>
					</svg>
					<span>LinkedIn</span>
				</a>
				
				<a href="mailto:aazainkhan@gmail.com" class="social-link" aria-label="Send me an email">
					<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="4" width="20" height="16" rx="2" ry="2"/>
						<polyline points="22,6 12,13 2,6"/>
					</svg>
					<span>Email</span>
				</a>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.contact-container {
		min-height: clamp(360px, 70dvh, 520px);
		padding: clamp(2rem, 5dvh, 5rem) clamp(16px, 4vw, 32px);
		display: grid;
		place-items: center;
	}

	.contact-content {
		max-width: 600px;
		text-align: center;
	}

	.contact-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 1.5rem;
		line-height: 1.2;
	}

	.contact-description {
		font-size: clamp(18px, 2vw, 22px);
		line-height: 1.6;
		opacity: 0.8;
		margin-bottom: 3rem;
		max-width: 500px;
		margin-left: auto;
		margin-right: auto;
	}

	.social-links {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
	}

	@media (width >= 640px) {
		.social-links {
			flex-direction: row;
			justify-content: center;
			gap: 2rem;
		}
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 2rem;
		border: 2px solid var(--button-bg);
		border-radius: 4px;
		background: var(--button-bg);
		color: var(--button-text);
		text-decoration: none;
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		font-size: 1.1rem;
		box-shadow: 4px 4px 0 0 var(--button-text), 6px 6px 0 0 var(--button-bg);
		transition: transform 0.1s ease, box-shadow 0.1s ease;
		min-width: 180px;
		justify-content: center;
		cursor: pointer;
	}

	.social-link:focus {
		outline: none;
		text-decoration: none;
	}

	.social-link:active {
		box-shadow: 2px 2px 0 0 var(--button-text), 3px 3px 0 0 var(--button-bg);
		transform: translate(2px, 2px);
		text-decoration: none;
	}

	.social-icon {
		width: 24px;
		height: 24px;
		stroke: currentcolor;
	}

	/* Large screens - maintain size */
	@media (width >= 1440px) {
		.contact-container {
			padding: 5rem 2rem;
		}

		.contact-content {
			max-width: 700px;
		}

		.contact-title {
			font-size: 56px;
		}

		.contact-description {
			font-size: 22px;
		}
	}

	/* 4K scaling */
	@media (width >= 1920px) {
		.contact-container { padding: 6rem 3rem; }
		.contact-content { max-width: 820px; }
		.contact-title { font-size: 64px; }
		.contact-description { font-size: 24px; max-width: 640px; }
		.social-links { gap: 2.25rem; }
		.social-link { font-size: 1.2rem; padding: 1.1rem 2.25rem; min-width: 220px; }
		.social-icon { width: 28px; height: 28px; }
	}

	/* Mobile-specific styles */
	@media (width <= 639px) {
		.contact-container {
			/* Top-align the content and drop it the same distance below the nav as
			   the About page's first heading (its mobile header padding + margin),
			   so the "Get in Touch" title lines up consistently. */
			align-items: start;
			padding-top: calc(clamp(2rem, 7svh, 6rem) + 2rem);
		}
		
		.contact-title {
			display: block;
		}
		
		.contact-description {
			margin-bottom: 2rem;
			font-size: 20px; /* Larger text on mobile */
		}
		
		.social-link {
			min-width: 200px;
		}
	}

</style>
