---
import { Image } from "astro:assets";
import Hero from "~/components/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

// Fetch all images from all albums from D1
const db = Astro.locals.runtime?.env?.DB;
let imagesData: any[] = [];
if (db) {
  try {
    const result = await db
      .prepare(`
        SELECT i.* FROM images i
        LEFT JOIN albums a ON i.album_id = a.id
        ORDER BY i.created_at DESC
      `)
      .all();
    imagesData = result.results ?? [];
  } catch {
    imagesData = [];
  }
}

type ImageData = {
  id: number;
  src: string;
  width: number;
  height: number;
  alt: string | null;
  album_id?: number;
};

// Convert D1 results to plain objects to avoid serialization issues
const images: ImageData[] = (imagesData || []).map((img: any) => ({
  id: img.id,
  src: img.src,
  width: img.width,
  height: img.height,
  alt: img.alt,
  album_id: img.album_id,
}));

const criticalImages = images.slice(0, 6);
const lazyImages = images.slice(6);
---

<BaseLayout
  title="Ma Galerie"
  description="A collection of my favorite photos."
>
  <Hero />
  
  {images.length > 0 && (
    <section class="justified-gallery" id="photoswipe">
      {criticalImages.map((image, index) => (
        <a
          class="gallery-item"
          style={`--width: ${image.width}; --height: ${image.height};`}
          href={image.src}
          target="_blank"
          data-fancybox="gallery"
          data-index={index}
        >
          <Image
            format="webp"
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt || "Gallery image"}
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </a>
      ))}
      {lazyImages.map((image, index) => (
        <a
          class="gallery-item"
          style={`--width: ${image.width}; --height: ${image.height};`}
          href={image.src}
          target="_blank"
          data-fancybox="gallery"
          data-index={index + 6}
        >
          <Image
            format="webp"
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt || "Gallery image"}
            loading="lazy"
            decoding="async"
          />
        </a>
      ))}
    </section>
  )}
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => Fancybox.bind("[data-fancybox]"));
  } else {
    Fancybox.bind("[data-fancybox]");
  }
</script>

<style>
  .justified-gallery {
    --padding: max(2.5vw, 12px);
    --space: max(2.5vw, 12px);
    --min-height: clamp(200px, 20vw, 400px);

    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);

    &::after {
      content: " ";
      flex-grow: 1000000000;
    }
  }

  .gallery-item {
    position: relative;
    flex-grow: calc(var(--width) * (100000 / var(--height)));
    flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
    aspect-ratio: var(--width) / var(--height);
    overflow: hidden;
    transition: all 0.05s ease-in-out;
  }

  .gallery-item img {
    display: block;
    object-fit: cover;
    height: 100%;
    width: 100%;
  }

  .gallery-item:focus-visible {
    outline: 3px solid var(--outline);
    outline-offset: 2px;
    transform: scale(1.05);
    z-index: 1;
    border-radius: 2px;
    box-shadow: 0 2px 4px 2px rgb(0 0 0 / 10%);
  }

  /* 4K scaling */
  @media (width >= 1920px) {
    .justified-gallery {
      --padding: max(2vw, 24px);
      --space: max(2vw, 20px);
      --min-height: clamp(280px, 18vw, 520px);
    }

    /* Enlarge Fancybox controls on 4K */
    :root {
      --f-button-width: 52px;
      --f-button-height: 52px;
      --f-toolbar-padding: 20px;
    }
  }


</style>
