---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../public/images/*.{jpg,jpeg,png,webp}",
);

// Pre-load critical images
const criticalImages = Object.entries(images).slice(0, 8);
const lazyImages = Object.entries(images).slice(8);
---

<BaseLayout
  title="Ma Galerie"
  description="A collection of my favorite photos."
>
  <section class="justified-gallery" id="photoswipe">
    <!-- Critical images loaded eagerly -->
    {
      criticalImages.map(async ([_path, image], index) => {
        const { default: imageData } = await image();
        return (
          <a
            style={`--width: ${imageData.width}; --height: ${imageData.height};`}
            href={imageData.src}
            target="_blank"
            data-fancybox="gallery"
            data-index={index}
          >
            <Image
              format="webp"
              src={imageData}
              alt="Gallery image"
              height={400}
              loading="eager"
              decoding="sync"
              fetchpriority="high"
            />
          </a>
        );
      })
    }
    
    <!-- Lazy loaded images -->
    {
      lazyImages.map(async ([_path, image], index) => {
        const { default: imageData } = await image();
        return (
          <a
            style={`--width: ${imageData.width}; --height: ${imageData.height};`}
            href={imageData.src}
            target="_blank"
            data-fancybox="gallery"
            data-index={index + 8}
          >
            <Image
              format="webp"
              src={imageData}
              alt="Gallery image"
              height={400}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </a>
        );
      })
    }
  </section>
</BaseLayout>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  // Initialize Fancybox with performance optimizations
  Fancybox.bind("[data-fancybox]");

  // Intersection Observer for better lazy loading
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const img = entry.target.querySelector('img');
          if (img && img.dataset.src) {
            img.src = img.dataset.src;
            img.removeAttribute('data-src');
            imageObserver.unobserve(entry.target);
          }
        }
      });
    }, {
      rootMargin: '50px 0px',
      threshold: 0.1
    });

    // Observe lazy images
    document.querySelectorAll('[data-fancybox]').forEach((link, index) => {
      if (index >= 8) {
        imageObserver.observe(link);
      }
    });
  }
</script>

<style>
  .justified-gallery {
    --padding: max(2.5vw, 12px);
    --space: max(2.5vw, 12px);
    --min-height: clamp(200px, 20vw, 400px);

    padding: var(--padding);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space);

    a {
      flex-grow: calc(var(--width) * (100000 / var(--height)));
      flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
      aspect-ratio: var(--width) / var(--height);
      overflow: hidden;
      opacity: 1;
      transition: all 0.05s ease-in-out;
    }

    a img {
      display: block;
      object-fit: cover;
      height: 100%;
      width: 100%;
    }

    a:focus-visible {
      outline: 3px solid var(--outline);
      outline-offset: 2px;
      transform: scale(1.05);
      z-index: 1;
      border-radius: 2px;
      box-shadow: 0 2px 4px 2px rgb(0 0 0 / 10%);
    }

    a.hidden {
      transition: opacity 0.4s ease-in-out;
      opacity: 0;
    }

    &::after {
      content: " ";
      flex-grow: 1000000000;
    }
  }

  /* 4K scaling */
  @media (width >= 1920px) {
    .justified-gallery {
      --padding: max(2vw, 24px);
      --space: max(2vw, 20px);
      --min-height: clamp(280px, 18vw, 520px);
    }

    /* Enlarge Fancybox controls on 4K */
    :root {
      --f-button-width: 52px;
      --f-button-height: 52px;
      --f-toolbar-padding: 20px;
    }
  }
</style>
