---
import DockApp from "~/components/DockApp";
import MacDesktop from "~/components/MacDesktop";
import BaseLayout from "~/layouts/BaseLayout.astro";

const db = Astro.locals.runtime?.env?.DB;

let albumsData: any[] = [];
if (db) {
  try {
    const result = await db
      .prepare(`
        SELECT
          a.*,
          i.src as cover_image_src
        FROM albums a
        LEFT JOIN images i ON a.cover_image_id = i.id
        ORDER BY a.created_at DESC
      `)
      .all();
    albumsData = result.results ?? [];
  } catch {
    albumsData = [];
  }
}

type Album = {
  id: number;
  title: string;
  slug: string;
  description: string | null;
  created_at: string;
  cover_image_id: number | null;
  cover_image_src: string | null;
};

const albums: Album[] = (albumsData || []).map((a: any) => ({
  id: a.id,
  title: a.title,
  slug: a.slug,
  description: a.description,
  created_at: a.created_at,
  cover_image_id: a.cover_image_id,
  cover_image_src: a.cover_image_src,
}));
---

<BaseLayout title="Albums" description="Explore photo albums as a Mac desktop.">
  {albums.length > 0 && <MacDesktop albums={albums} client:only="react" />}
  {albums.length === 0 && (
    <section class="albums-empty">
      <p>No albums yet. Create one in the admin panel!</p>
    </section>
  )}

  {albums.length > 0 && (
    <div class="mobile-albums">
      {albums.map(album => (
        <a href={`/albums/${album.slug}`} class="mobile-album-item">
          <div class="mobile-album-folder">
            <img src="/icons/macos-folder-original.png" alt={album.title} draggable="false" />
          </div>
          <span class="mobile-album-label">{album.title}</span>
        </a>
      ))}
    </div>
  )}

  <DockApp client:load />
</BaseLayout>

<style>
  .albums-empty {
    display: grid;
    place-items: center;
    min-height: 60dvh;
    color: var(--text);
    opacity: 0.5;
    font-size: 1rem;
  }

  .mobile-albums {
    display: none;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 12px;
    padding: 20px 16px 180px;
  }

  @media (width <= 639px) {
    .mobile-albums {
      display: grid;
    }
  }

  .mobile-album-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    text-decoration: none;
    cursor: default;
  }

  .mobile-album-folder {
    width: 72px;
    height: 72px;
  }

  .mobile-album-folder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .mobile-album-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--icon-label-color);
    text-shadow: var(--icon-label-shadow);
    text-align: center;
    line-height: 1.35;
    max-width: 82px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
