---
import { AboutMoi } from "~/components/ui/about-moi-feature-section";
import VisionStatement from "~/components/VisionStatement";
import BaseLayout from "~/layouts/BaseLayout.astro";

// All About-page copy (Ma Galerie intro, Ma Vision, Ma Gear) is editable in the
// admin "About" tab and stored as JSON in the site_content table; the "About
// Moi" image blocks live in the about_moi table. Defaults below are the fallback
// when nothing has been saved yet.
const galerieDefault = {
  title: "About Ma Galerie",
  body: "Welcome to Ma Galerie, a curated collection of photography that captures moments, emotions, and the beauty of the world around us.\n\nThis gallery showcases a variety of photographic styles and subjects, from landscapes and nature to portraits and street photography. Each image tells a story and invites you to see the world through a different lens.\n\nThe gallery is built with modern web technologies to provide a seamless viewing experience across all devices, featuring a responsive design and an intuitive lightbox for exploring images in detail.",
};
const visionDefault = {
  title: "Ma Vision",
  lead: "My vision is to capture the essence of",
  words: [
    {
      text: "life",
      img: "https://images.unsplash.com/photo-1718969604981-de826f44ce15?w=440&h=300&fit=crop&auto=format",
    },
    {
      text: "emotion",
      img: "https://images.unsplash.com/photo-1476180814856-a36609db0493?w=440&h=300&fit=crop&auto=format",
    },
    {
      text: "beauty",
      img: "https://images.unsplash.com/photo-1595407660626-db35dcd16609?w=440&h=300&fit=crop&auto=format",
    },
  ],
  close:
    "in every frame. Through my lens, I strive to tell stories that resonate, inspire, and connect us to the world and each other.",
};
const gearDefault = {
  title: "Ma Gear",
  description:
    "Behind every great photograph is the right equipment. Here's a look at the gear that helps bring these images to life.",
  items: [
    { icon: "📷", name: "Sony A7IV", category: "Body" },
    { icon: "🔍", name: "Sony 35mm f/1.4 GM", category: "Lens" },
    { icon: "🔍", name: "Sony 85mm f/1.8", category: "Lens" },
    { icon: "📐", name: "Peak Design Tripod", category: "Accessory" },
  ],
};

const db = Astro.locals.runtime?.env?.DB;
let aboutMoiFeatures: {
  title: string | null;
  text: string | null;
  img: string | null;
}[] = [];
let galerie = galerieDefault;
let vision = visionDefault;
let gear = gearDefault;

if (db) {
  try {
    await db
      .prepare(
        `CREATE TABLE IF NOT EXISTS about_moi (
          slot INTEGER PRIMARY KEY, title TEXT, text TEXT, image_src TEXT
        )`,
      )
      .run();
    const res = await db
      .prepare(
        "SELECT slot, title, text, image_src FROM about_moi ORDER BY slot ASC",
      )
      .all();
    aboutMoiFeatures = (res.results ?? []).map((r: any) => ({
      title: r.title,
      text: r.text,
      img: r.image_src,
    }));

    await db
      .prepare(
        "CREATE TABLE IF NOT EXISTS site_content (key TEXT PRIMARY KEY, value TEXT)",
      )
      .run();
    const sc = await db.prepare("SELECT key, value FROM site_content").all();
    const map: Record<string, any> = {};
    for (const r of (sc.results ?? []) as any[]) {
      try {
        map[r.key] = JSON.parse(r.value);
      } catch {}
    }
    if (map.galerie) galerie = { ...galerieDefault, ...map.galerie };
    if (map.vision)
      vision = {
        ...visionDefault,
        ...map.vision,
        words: map.vision.words ?? visionDefault.words,
      };
    if (map.gear)
      gear = {
        ...gearDefault,
        ...map.gear,
        items: map.gear.items ?? gearDefault.items,
      };
  } catch {
    aboutMoiFeatures = [];
  }
}

const galerieParagraphs = (galerie.body || "")
  .split(/\n\n+/)
  .map((p: string) => p.trim())
  .filter(Boolean);
---

<BaseLayout title="About" description="Learn more about Ma Galerie and my photography journey.">
	<!-- About header for mobile -->
	<div class="mobile-header">
		<h1 style="font-size: clamp(32px, 8vw, 62px); opacity: .8; font-family: PPEditorialNew-Ultralight, sans-serif; font-display: swap; text-align: center; padding: 2rem 0; margin-top: 2rem;">{galerie.title}</h1>
	</div>

	<!-- About content for desktop -->
	<main class="about-container">
		<div class="about-content">
			<h1 class="about-title">{galerie.title}</h1>
			<div class="about-text">
				{galerieParagraphs.map((p: string) => <p>{p}</p>)}
			</div>
		</div>

		<!-- About Moi + the "I am from" journey (moved from the home page) -->
		<div class="about-extra">
			<AboutMoi features={aboutMoiFeatures} client:visible />
		</div>

		<!-- Ma Vision Section -->
		<section class="vision-section">
  <div class="vision-content">
    <h2 class="vision-title">{vision.title}</h2>
    <VisionStatement lead={vision.lead} words={vision.words} close={vision.close} client:visible />
  </div>
</section>

		<!-- Ma Gear Section -->
		<section class="gear-section">
			<div class="gear-content">
				<h2 class="gear-title">{gear.title}</h2>
				<p class="gear-description">
					{gear.description}
				</p>
				<div class="gear-grid">
					{gear.items.map((item: { icon: string; name: string; category: string }) => (
						<div class="gear-item">
							<div class="gear-placeholder">
								<span style="font-size: 2rem; display: block; margin-bottom: 0.5rem;">{item.icon}</span>
								<span class="gear-name">{item.name}</span>
								<span class="gear-category">{item.category}</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Contact Section -->
		<section class="contact-section">
			<div class="contact-content">
				<h2 class="contact-title">Let's Create</h2>
				<p class="contact-text">
					Interested in working together or purchasing a print?
				</p>
				<a href="/contact" class="button-50" role="button">Get in Touch</a>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.about-container {
		/* breather between the section "screens" */
		--section-gap: clamp(4rem, 8vh, 6rem);
		min-height: clamp(360px, 70dvh, 520px);
		padding: clamp(2rem, 5dvh, 5rem) clamp(16px, 4vw, 32px);
		display: grid;
		place-items: center;
		row-gap: var(--section-gap);
	}

	/* Each short section gets close to a full screen with its content vertically
	   centred, so only one section is really in view at a time and they don't
	   clash together. (The tall feature sections already exceed this.) */
	.about-content,
	.vision-section,
	.gear-section,
	.contact-section {
		min-height: clamp(460px, 78vh, 880px);
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	/* Lets the React feature sections span the full column width instead of
	   being shrunk to content by the centred grid, and spaces the two of them
	   with the same rhythm as the rest of the page. */
	.about-extra {
		width: 100%;
		justify-self: stretch;
		display: flex;
		flex-direction: column;
		gap: var(--section-gap);
	}

	.about-content {
		max-width: 700px;
		text-align: center;
	}

	.about-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 2rem;
		line-height: 1.2;
	}

	.about-text {
		text-align: center;
		line-height: 1.7;
	}

	.about-text p {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.8;
		margin-bottom: 1.5rem;
	}

	.about-text p:last-child {
		margin-bottom: 0;
	}

	/* Ma Vision Section */
	.vision-section {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		padding: 0 clamp(16px, 4vw, 32px);
	}

	.vision-content {
		text-align: center;
	}

	.vision-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.vision-description {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.8;
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		line-height: 1.6;
	}

	.gear-section {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 clamp(16px, 4vw, 32px);
	}

	.gear-content {
		text-align: center;
	}

	.gear-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.gear-description {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.7;
		margin-bottom: 2.5rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		line-height: 1.6;
	}

	.gear-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.gear-item {
		aspect-ratio: 4/3;
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.3s ease;
	}

	.gear-item:hover {
		transform: translateY(-4px);
	}

	.gear-placeholder {
		width: 100%;
		height: 100%;
		background: color-mix(in oklab, var(--text) 5%, transparent);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		font-weight: 500;
		color: var(--text);
		border: 1px solid color-mix(in oklab, var(--text) 12%, transparent);
		border-radius: 8px;
	}

	/* Contact Section Styles */
	.contact-section {
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
		padding: 0 clamp(16px, 4vw, 32px);
		text-align: center;
	}

	.contact-title {
		font-size: clamp(32px, 6vw, 48px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		margin-bottom: 1rem;
	}

	.contact-text {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.8;
		margin-bottom: 2rem;
	}

	.button-50 {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 2rem;
		border: 2px solid var(--button-bg);
		border-radius: 4px;
		background: var(--button-bg);
		color: var(--button-text);
		text-decoration: none;
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		font-size: 1.1rem;
		box-shadow: 4px 4px 0 0 var(--button-text), 6px 6px 0 0 var(--button-bg);
		transition: transform 0.1s ease, box-shadow 0.1s ease;
		min-width: 180px;
		justify-content: center;
		cursor: pointer;
		text-transform: none;
		touch-action: manipulation;
		user-select: none;
		-webkit-user-select: none;
	}

	.button-50:focus {
		outline: none;
		text-decoration: none;
	}

	.button-50:active {
		box-shadow: 2px 2px 0 0 var(--button-text), 3px 3px 0 0 var(--button-bg);
		transform: translate(2px, 2px);
		text-decoration: none;
	}

	@media (width >= 768px) {
		.button-50 {
			padding: 1rem 2.5rem;
		}
	}

	.gear-name {
		font-weight: 600;
		color: var(--text);
		opacity: 0.85;
	}

	.gear-category {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-top: 0.25rem;
		color: var(--text);
		opacity: 0.55;
	}

	/* Large screens - maintain size */
	@media (width >= 1440px) {
		.about-container {
			padding: 5rem 2rem;
		}

		.about-content {
			max-width: 800px;
		}

		.about-title {
			font-size: 56px;
		}

		.about-text p {
			font-size: 20px;
		}

		.gear-title {
			font-size: 56px;
		}

		.gear-description {
			font-size: 20px;
		}

		.gear-section {
			padding: 0 2rem;
		}
	}

	/* 4K scaling */
	@media (width >= 1920px) {
		.about-container {
			padding: 6rem 3rem;
		}

		.about-content {
			max-width: 960px;
		}

		.about-title {
			font-size: 64px;
		}

		.about-text p {
			font-size: 22px;
		}

		.gear-title {
			font-size: 64px;
		}

		.gear-description {
			font-size: 22px;
			max-width: 720px;
		}

		.gear-grid {
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 2rem;
		}
	}

	/* Mobile-specific styles */
	@media (width <= 639px) {
		.about-container {
			padding-top: 1rem;
		}
		
		.about-title {
			display: none; /* Hide desktop title on mobile since we have mobile header */
		}
		
		.about-text {
			text-align: center;
		}

		.about-text p {
			font-size: 20px; /* Larger text on mobile */
		}

		.gear-description {
			font-size: 20px; /* Larger text on mobile */
		}

		.gear-grid {
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1rem;
		}

		.gear-placeholder {
			font-size: 16px;
		}
	}

	/* Hide mobile header on desktop */
	@media (width >= 640px) {
		.mobile-header {
			display: none;
		}
	}
</style>
