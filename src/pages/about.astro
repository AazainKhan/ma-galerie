---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="Learn more about Ma Galerie and my photography journey.">
	<!-- About header for mobile -->
	<div class="mobile-header">
		<h1 style="font-size: clamp(32px, 8vw, 62px); opacity: .8; font-family: PPEditorialNew-Ultralight, sans-serif; font-display: swap; text-align: center; padding: 2rem 0; margin-top: 2rem;">About Ma Galerie</h1>
	</div>

	<!-- About content for desktop -->
	<main class="about-container">
		<div class="about-content">
			<h1 class="about-title">About Ma Galerie</h1>
			<div class="about-text">
				<p>
					Welcome to Ma Galerie, a curated collection of photography that captures moments, emotions, and the beauty of the world around us.
				</p>
				<p>
					This gallery showcases a variety of photographic styles and subjects, from landscapes and nature to portraits and street photography. Each image tells a story and invites you to see the world through a different lens.
				</p>
				<p>
					The gallery is built with modern web technologies to provide a seamless viewing experience across all devices, featuring a responsive design and an intuitive lightbox for exploring images in detail.
				</p>
			</div>
		</div>

		<!-- Ma Vision Section -->
		<section class="vision-section">
  <div class="vision-content">
    <h2 class="vision-title">Ma Vision</h2>
    <p class="vision-description">
      My vision is to capture the essence of life, emotion, and beauty in every frame. Through my lens, I strive to tell stories that resonate, inspire, and connect us to the world and each other.
    </p>
  </div>
</section>

		<!-- Ma Gear Section -->
		<section class="gear-section">
			<div class="gear-content">
				<h2 class="gear-title">Ma Gear</h2>
				<p class="gear-description">
					Behind every great photograph is the right equipment. Here's a look at the gear that helps bring these images to life.
				</p>
				<div class="gear-grid">
					<!-- Add your gear images here -->
					<div class="gear-item">
						<div class="gear-placeholder">
							<span>Camera Body</span>
						</div>
					</div>
					<div class="gear-item">
						<div class="gear-placeholder">
							<span>Lenses</span>
						</div>
					</div>
					<div class="gear-item">
						<div class="gear-placeholder">
							<span>Accessories</span>
						</div>
					</div>
					<div class="gear-item">
						<div class="gear-placeholder">
							<span>Tripods</span>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.about-container {
		min-height: clamp(360px, 70dvh, 520px);
		padding: clamp(2rem, 5dvh, 5rem) clamp(16px, 4vw, 32px);
		display: grid;
		place-items: center;
	}

	.about-content {
		max-width: 700px;
		text-align: center;
	}

	.about-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 2rem;
		line-height: 1.2;
	}

	.about-text {
		text-align: left;
		line-height: 1.7;
	}

	.about-text p {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.8;
		margin-bottom: 1.5rem;
	}

	.about-text p:last-child {
		margin-bottom: 0;
	}

	/* Ma Vision Section */
	.vision-section {
		width: 100%;
		max-width: 900px;
		margin: 3rem auto 0 auto;
		padding: 0 clamp(16px, 4vw, 32px);
	}

	.vision-content {
		text-align: center;
	}

	.vision-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.vision-description {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.8;
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		line-height: 1.6;
	}

	.gear-section {
		width: 100%;
		max-width: 1200px;
		margin-top: 4rem;
		padding: 0 clamp(16px, 4vw, 32px);
	}

	.gear-content {
		text-align: center;
	}

	.gear-title {
font-size: clamp(32px, 8vw, 56px);
		font-family: PPEditorialNew, serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 1rem;
		line-height: 1.2;
	}

	.gear-description {
		font-size: clamp(18px, 2vw, 20px);
		opacity: 0.7;
		margin-bottom: 2.5rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
		line-height: 1.6;
	}

	.gear-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}

	.gear-item {
		aspect-ratio: 4/3;
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.3s ease;
	}

	.gear-item:hover {
		transform: translateY(-4px);
	}

	.gear-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		font-weight: 500;
		color: #666;
		border: 2px dashed #ccc;
	}

	.gear-placeholder span {
		opacity: 0.7;
	}

	/* Large screens - maintain size */
 	@media (width >= 1440px) {
		.about-container {
			padding: 5rem 2rem;
		}

		.about-content {
			max-width: 800px;
		}

	/* 4K scaling */
	@media (width >= 1920px) {
		.about-container { padding: 6rem 3rem; }
		.about-content { max-width: 960px; }
		.about-title { font-size: 64px; }
		.about-text p { font-size: 22px; }
		.gear-title { font-size: 64px; }
		.gear-description { font-size: 22px; max-width: 720px; }
		.gear-grid { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
	}

		.about-title {
			font-size: 56px;
		}

		.about-text p {
			font-size: 20px;
		}

		.gear-title {
 font-size: 56px;
		}

		.gear-description {
			font-size: 20px;
		}

		.gear-section {
			padding: 0 2rem;
		}
	}

	/* Mobile-specific styles */
	@media (width <= 639px) {
		.about-container {
			padding-top: 1rem;
		}
		
		.about-title {
			display: none; /* Hide desktop title on mobile since we have mobile header */
		}
		
		.about-text {
			text-align: center;
		}

		.about-text p {
			font-size: 20px; /* Larger text on mobile */
		}

		.gear-section {
			margin-top: 3rem;
		}

		.gear-description {
			font-size: 20px; /* Larger text on mobile */
		}

		.gear-grid {
			grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
			gap: 1rem;
		}

		.gear-placeholder {
			font-size: 16px;
		}
	}

	/* Hide mobile header on desktop */
	@media (width >= 640px) {
		.mobile-header {
			display: none;
		}
	}
</style>
