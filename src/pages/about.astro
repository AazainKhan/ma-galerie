---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="Learn more about Ma Galerie and my photography journey.">
	<!-- About header for mobile -->
	<div class="mobile-header">
		<h1 style="font-size: clamp(32px, 8vw, 62px); opacity: .8; font-family: PPEditorialNew-Ultralight, sans-serif; font-display: swap; text-align: center; padding: 2rem 0; margin-top: 2rem;">About</h1>
	</div>

	<!-- About content for desktop -->
	<main class="about-container">
		<div class="about-content">
			<h1 class="about-title">About Ma Galerie</h1>
			<div class="about-text">
				<p>
					Welcome to Ma Galerie, a curated collection of photography that captures moments, emotions, and the beauty of the world around us.
				</p>
				<p>
					This gallery showcases a variety of photographic styles and subjects, from landscapes and nature to portraits and street photography. Each image tells a story and invites you to see the world through a different lens.
				</p>
				<p>
					The gallery is built with modern web technologies to provide a seamless viewing experience across all devices, featuring a responsive design and an intuitive lightbox for exploring images in detail.
				</p>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.about-container {
		min-height: clamp(360px, 70dvh, 520px);
		padding: clamp(2rem, 5dvh, 5rem) clamp(16px, 4vw, 32px);
		display: grid;
		place-items: center;
	}

	.about-content {
		max-width: 700px;
		text-align: center;
	}

	.about-title {
		font-size: clamp(32px, 8vw, 56px);
		font-family: "PPEditorialNew", serif;
		font-weight: 200;
		opacity: 0.9;
		margin-bottom: 2rem;
		line-height: 1.2;
	}

	.about-text {
		text-align: left;
		line-height: 1.7;
	}

	.about-text p {
		font-size: clamp(16px, 2vw, 18px);
		opacity: 0.8;
		margin-bottom: 1.5rem;
	}

	.about-text p:last-child {
		margin-bottom: 0;
	}

	/* Mobile-specific styles */
	@media (max-width: 639px) {
		.about-container {
			padding-top: 1rem;
		}
		
		.about-title {
			display: none; /* Hide desktop title on mobile since we have mobile header */
		}
		
		.about-text {
			text-align: center;
		}
	}

	/* Hide mobile header on desktop */
	@media (min-width: 640px) {
		.mobile-header {
			display: none;
		}
	}
</style>
